{
  "name": "@recipe-planner/components",
  "version": "1.0.0",
  "description": "Reusable StencilJS components for the Recipe Finder & Meal Planner.",
  "keywords": [
    "stencil",
    "web-components",
    "recipe",
    "meal-planner",
    "svelte"
  ],
  "author": "Recipe Finder Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/deptiwddn/recipe-finder-meal-planner.git",
    "directory": "packages/recipe-components"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/components.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/recipe-planner-components/recipe-planner-components.esm.js",
  "exports": {
    ".": {
      "types": "./dist/types/components.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs.js"
    },
    "./loader": {
      "types": "./dist/loader/index.d.ts",
      "import": "./dist/loader/index.js",
      "require": "./dist/loader/index.cjs.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "stencil build",
    "start": "stencil build --dev --watch --serve",
    "test": "stencil test --spec",
    "test:watch": "stencil test --spec --watchAll",
    "generate": "stencil generate"
  },
  "devDependencies": {
    "@stencil/core": "^4.36.0",
    "@types/jest": "^29.5.0",
    "jest": "^29.7.0",
    "jest-cli": "^29.7.0",
    "typescript": "^5.9.0"
  }
}
