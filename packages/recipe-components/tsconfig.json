{
  "include": ["src"],
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "es2020",
    "lib": ["dom", "es2020"],
    "jsx": "react-jsx",
    "jsxImportSource": "@stencil/core"
  }
}
